<Page
    x:Class="EncodePlus.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:local="using:AboutPage"
    Background="{ThemeResource BackgroundBrush}">

    <Pivot Title="Encode+">
        <PivotItem Header="Home">
            <StackPanel>
                <StackPanel.Resources>
                    <Style x:Key="Child" TargetType="Control">
                        <Setter Property="Margin" Value="0,15,0,0"/>
                    </Style>
                    <Style x:Key="TextBox" TargetType="TextBox" BasedOn="{StaticResource Child}">
                        <Setter Property="Padding" Value="10"/>
                        <Setter Property="AcceptsReturn" Value="True"/>
                    </Style>
                </StackPanel.Resources>
                
                <TextBox x:Name="TextBoxInput" PlaceholderText="Input text" Style="{StaticResource TextBox}"/>
                <TextBox x:Name="TextBoxOutput" PlaceholderText="Output text"  Style="{StaticResource TextBox}"/>
                <ComboBox x:Name="ComboBox" HorizontalAlignment="Stretch" SelectedIndex="0" Style="{StaticResource Child}" SelectionChanged="ComboBox_SelectionChanged"/>
                
                <StackPanel HorizontalAlignment="Stretch" Margin="0,10,0,0" VerticalAlignment="Stretch">
                    <Grid HorizontalAlignment="Stretch" Margin="0,0,0,0" VerticalAlignment="Stretch" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="EncodeButton" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="0,10,10,10" RequestedTheme="Default" Padding="10,10,10,10" MaxWidth="500" FontWeight="Bold" Click="EncodeButton_Click" >
                            <Button.Foreground>
                                <SolidColorBrush Color="{ThemeResource SystemColorWindowColor}"/>
                            </Button.Foreground>
                            <Button.Background>
                                <SolidColorBrush Color="{ThemeResource SystemAccentColor}"/>
                            </Button.Background>
                            <StackPanel Orientation="Horizontal">
                                <SymbolIcon Symbol="Admin"/>
                                <TextBlock Text="Encode" TextWrapping="Wrap" Margin="5,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="DecodeButton" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="10,10,0,10" RequestedTheme="Default" Padding="10,10,10,10" MaxWidth="500" Grid.Column="1" FontWeight="Bold" Click="DecodeButton_Click" >
                            <Button.Foreground>
                                <SolidColorBrush Color="{ThemeResource SystemColorWindowColor}"/>
                            </Button.Foreground>
                            <Button.Background>
                                <SolidColorBrush Color="{ThemeResource SystemAccentColor}"/>
                            </Button.Background>
                            <StackPanel Orientation="Horizontal">
                                <SymbolIcon Symbol="View"/>
                                <TextBlock Text="Decode" TextWrapping="Wrap" Margin="5,0,0,0"/>
                            </StackPanel>
                        </Button>

                    </Grid>
                    <Grid HorizontalAlignment="Stretch" Margin="0,0,0,0" VerticalAlignment="Stretch" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="CopyButton" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="0,10,10,10" RequestedTheme="Default" Padding="10,10,10,10" MaxWidth="500" FontWeight="Bold" Click="CopyButton_Click" >
                            <Button.Foreground>
                                <SolidColorBrush Color="{ThemeResource SystemColorWindowColor}"/>
                            </Button.Foreground>
                            <Button.Background>
                                <SolidColorBrush Color="{ThemeResource SystemAccentColor}"/>
                            </Button.Background>
                            <StackPanel Orientation="Horizontal">
                                <SymbolIcon Symbol="Copy"/>
                                <TextBlock Text="Copy" TextWrapping="Wrap" Margin="5,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ClearButton" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="10,10,0,10" RequestedTheme="Default" Padding="10,10,10,10" MaxWidth="500" Grid.Column="1" FontWeight="Bold" Click="ClearButton_Click" >
                            <Button.Foreground>
                                <SolidColorBrush Color="{ThemeResource SystemColorWindowColor}"/>
                            </Button.Foreground>
                            <Button.Background>
                                <SolidColorBrush Color="{ThemeResource SystemAccentColor}"/>
                            </Button.Background>
                            <StackPanel Orientation="Horizontal">
                                <SymbolIcon Symbol="Clear"/>
                                <TextBlock Text="Clear" TextWrapping="Wrap" Margin="5,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </PivotItem>
        <PivotItem Header="About">
            <local:AboutPage x:Name="AboutPage"/>
        </PivotItem>
    </Pivot>
</Page>
