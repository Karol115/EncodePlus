<Page xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    x:Class="EncodePlus.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:local="using:AboutPage"
    Background="{ThemeResource BackgroundBrush}">

    <Pivot Title="Encode+" HeaderFocusVisualPlacement="SelectedItemHeader">
        <PivotItem Header="Home">
            <StackPanel>
                <StackPanel.Resources>
                    <Style x:Key="Child" TargetType="Control">
                        <Setter Property="Margin" Value="0,15,0,0"/>
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>

                    <Style x:Key="TextBox" TargetType="TextBox" BasedOn="{StaticResource Child}">
                        <Setter Property="Padding" Value="10"/>
                        <Setter Property="AcceptsReturn" Value="True"/>
                    </Style>

                    <Style x:Key="AccentedButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Padding" Value="10"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="CornerRadius" Value="8"/>
                        <Setter Property="Foreground" Value="{ThemeResource SystemColorWindowColor}"/>
                        <Setter Property="Background" Value="{ThemeResource SystemAccentColor}"/>
                    </Style>
                </StackPanel.Resources>

                <TextBox x:Name="TextBoxInput" PlaceholderText="Input text" Style="{StaticResource TextBox}" TextChanged="TextBoxInput_TextChanged"/>
                <TextBlock x:Name="DetectionHintTextBlock" Text="Not Detected" FontSize="12" Foreground="Gray" Margin="5,2,0,0" FontStyle="Italic"/>
                <TextBox x:Name="TextBoxOutput" PlaceholderText="Output text" Style="{StaticResource TextBox}"/>

                <muxc:ProgressBar x:Name="DecodingProgressBar" IsIndeterminate="True" Visibility="Collapsed" Margin="0,5,0,0" CornerRadius="4"/>

                <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch">
                    <ComboBox x:Name="ComboBox" SelectedIndex="0" Style="{StaticResource Child}" SelectionChanged="ComboBox_SelectionChanged"/>
                    <ComboBox x:Name="ComboBoxAdditional" SelectedIndex="0" Visibility="Collapsed" Style="{StaticResource Child}" SelectionChanged="ComboBoxAdditional_SelectionChanged"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Stretch" Margin="0,10,0,0" VerticalAlignment="Stretch">
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Button x:Name="EncodeButton" Grid.Row="0" Grid.Column="0" Style="{StaticResource AccentedButton}" Margin="0,0,5,5" Click="EncodeButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <SymbolIcon Symbol="Admin"/>
                                <TextBlock Text="Encode" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="DecodeButton" Grid.Row="0" Grid.Column="1" Style="{StaticResource AccentedButton}" Margin="5,0,0,5" Click="DecodeButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <SymbolIcon Symbol="View"/>
                                <TextBlock Text="Decode" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="CopyButton" Grid.Row="1" Grid.Column="0" Style="{StaticResource AccentedButton}" Background="Transparent" Foreground="{ThemeResource SystemBaseHighColor}" Margin="0,5,5,5" Click="CopyButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <SymbolIcon Symbol="Copy"/>
                                <TextBlock Text="Copy" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="ClearButton" Grid.Row="1" Grid.Column="1" Style="{StaticResource AccentedButton}" Background="Transparent" Foreground="{ThemeResource SystemBaseHighColor}" Margin="5,5,0,5" Click="ClearButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <SymbolIcon Symbol="Clear"/>
                                <TextBlock Text="Clear" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="AutoDetectButton" Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource AccentedButton}" Background="Transparent" Foreground="{ThemeResource SystemBaseHighColor}" Margin="0,5,0,5" Click="AutoDetectButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <SymbolIcon Symbol="Scan"/>
                                <TextBlock Text="Auto Detect Encoding Format: Off" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border x:Name="OperationsStatusStackPanel" 
                            Visibility="Collapsed" 
                            BorderBrush="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
                            BorderThickness="0"
                            CornerRadius="8"
                            Padding="10">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                            <TextBlock x:Name="StatusTimerTextBlock" FontSize="14" TextAlignment="Center" FontWeight="SemiBold"/>
                            <TextBlock x:Name="StatusSpeedTextBlock" FontSize="14" TextAlignment="Center" Foreground="Gray"/>
                            <TextBlock x:Name="StatusTotalTextBlock" FontSize="14" TextAlignment="Center" Foreground="Gray"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </PivotItem>

        <PivotItem Header="Settings">
            <StackPanel Padding="10">
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Text="Max Threads" Grid.Row="0" Grid.Column="0" FontSize="16" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <ComboBox x:Name="ComboThreads" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" CornerRadius="8" SelectionChanged="ComboThreads_SelectionChanged"/>

                    <TextBlock Text="Search Depth"  Grid.Row="1" Grid.Column="0" FontSize="16" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <muxc:NumberBox x:Name="MaxLengthToBruteforce" Grid.Row="1" Grid.Column="1" Value="5" Minimum="1" SpinButtonPlacementMode="Inline" CornerRadius="8" Margin="0,5" ValueChanged="MaxLengthToBruteforce_ValueChanged"/>
                </Grid>
            </StackPanel>
        </PivotItem>

        <PivotItem Header="About">
            <local:AboutPage x:Name="AboutPage"/>
        </PivotItem>
    </Pivot>
</Page>